# Backend/Worker common
ENVIRONMENT=dev
SECRET_KEY=dev-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Database/Cache
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/app
REDIS_URL=redis://redis:6379/0

# Storage (Cloudflare R2 - S3 compatible)
# For local dev with MinIO, keep S3_ENDPOINT=http://minio:9000 and creds below.
# For Cloudflare R2 in staging/prod:
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_BUCKET=<your-bucket-name>
#   S3_ACCESS_KEY=<r2-access-key-id>
#   S3_SECRET_KEY=<r2-secret-access-key>
S3_ENDPOINT=http://minio:9000
S3_BUCKET=app
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=auto

# OpenAI (optional)
OPENAI_API_KEY=

# M-Pesa Daraja (sandbox)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://host.docker.internal:8080/billing/callback